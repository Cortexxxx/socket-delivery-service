<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:gui="clr-namespace:DeliveryService.Client.GUI"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="620"
        x:Class="DeliveryService.Client.GUI.MainWindow"
        Title="DeliveryService"
        Width="1100" Height="620"
        MinWidth="900" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <Grid ColumnDefinitions="*, 320">

        <Border Grid.Column="0" Padding="12">
            <gui:MapControl x:Name="Map" />
        </Border>

        <Border Grid.Column="1" Classes="sidebar">
            <Grid RowDefinitions="*, Auto">

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Spacing="12">

                        <Border Classes="card">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="section" Text="SESSION" />
                                <TextBlock x:Name="RoleText" Classes="heading" Text="" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Ellipse x:Name="ConnectionDot" Classes="dot" />
                                    <TextBlock x:Name="ConnectionStatus" Classes="muted" Text="Not connected" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="ROBOT" />
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="12" RowSpacing="6">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Position" />
                                    <TextBlock x:Name="PositionText" Grid.Row="0" Grid.Column="1"
                                               Classes="value" Text="-" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Heading" />
                                    <TextBlock x:Name="AngleText" Grid.Row="1" Grid.Column="1"
                                               Classes="value" Text="-" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="CURRENT ORDER" />
                                <TextBlock x:Name="CurrentOrderText" Classes="body" Text="No active order" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="ORDERS" />
                                <TextBlock x:Name="OrdersText" Classes="body mono" Text="No orders yet" />
                            </StackPanel>
                        </Border>

                        <Border Classes="card">
                            <StackPanel Spacing="8">
                                <TextBlock Classes="section" Text="LAST EVENT" />
                                <TextBlock x:Name="LastEventText" Classes="body" Text="-" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <StackPanel Grid.Row="1">

                    <TextBlock x:Name="HintText" Classes="hint" Text="" />

                    <Border x:Name="OrderPanel" Classes="card" Margin="0 12 0 0">
                        <StackPanel Spacing="12">
                            <TextBlock Classes="section" Text="NEW ORDER" />

                            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"
                                  ColumnSpacing="10" RowSpacing="4">
                                <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="X" />
                                <TextBlock Grid.Row="0" Grid.Column="1" Classes="label" Text="Y" />

                                <NumericUpDown x:Name="OrderX" Grid.Row="1" Grid.Column="0"
                                               Minimum="0" Maximum="255" Value="0"
                                               Increment="1" FormatString="0"
                                               ShowButtonSpinner="False" />
                                <NumericUpDown x:Name="OrderY" Grid.Row="1" Grid.Column="1"
                                               Minimum="0" Maximum="255" Value="0"
                                               Increment="1" FormatString="0"
                                               ShowButtonSpinner="False" />
                            </Grid>

                            <Button x:Name="CreateOrderButton" Classes="primary"
                                    Content="Create order"
                                    Click="CreateOrderButton_Click" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
